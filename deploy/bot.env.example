# Токен от @BotFather
BOT_TOKEN=123456:AA...
# Твой telegram id (узнать: @userinfobot). Все остальные игнорируются молча.
OWNER_ID=123456789
# Часовой пояс: по нему считаются «сегодня» и время напоминаний
TZ=Europe/Moscow
# Файл базы SQLite
DATA_PATH=/opt/tracker/data/tracker.db
# Сервис распознавания речи
ASR_URL=http://127.0.0.1:8081/transcribe
# Все голосовые после ASR отправляются в OpenAI-compatible API.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4-mini
# TRANSCRIBE_MODEL=gpt-transcribe
# TRANSCRIBE_PROMPT=Русский личный дневник. Точно записывай числа и время цифрами.
# Ollama остаётся фолбэком, если LLM_API_KEY не задан.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Несколько пользователей: telegram_id:имя:логин_дашборда:пароль.
# TRACKER_USERS=949465743:Паша:owner:change-me,908821693:Света:friend:change-me-too
# Лёгкий read-only дашборд. Слушать только localhost.
# DASHBOARD_ADDR=127.0.0.1:8080
# Эти две переменные используются только без TRACKER_USERS.
# DASHBOARD_USER=tracker
# DASHBOARD_PASSWORD=change-me

# Ежедневная SQLite-копия локально и в Telegram главного OWNER_ID.
# BACKUP_DIR=/opt/tracker/data/backups
# DAILY_BACKUP=04:00

# Пороги для флагов недельного разбора (значения по умолчанию)
# MAX_WAKE_SPREAD_H=1.5
# MIN_SAVINGS_RATE=0.55

# Расписание напоминаний
# DAILY_REMINDER=23:00
# WEEKLY_REPORT=12:40
# WEEKLY_REPORT_DAYS=7
# 5-го — зарплата, 20-го — аванс.
# INCOME_REMINDER=10:00
# Финансовый итог прошлого месяца и AI-анализ приходят 1-го числа.
# MONTHLY_FINANCE=10:15
