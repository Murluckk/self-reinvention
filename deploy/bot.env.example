# Токен от @BotFather
BOT_TOKEN=123456:AA...
# Telegram id владельца (узнать: @userinfobot): админские команды /invite,
# /users, /remove, /health, ежедневный бэкап и алерты о сбоях.
OWNER_ID=123456789
# Часовой пояс служебных задач (бэкап). У каждого пользователя свой пояс — /tz.
TZ=Europe/Moscow
# Файл базы SQLite
DATA_PATH=/opt/tracker/data/tracker.db
# Сервис распознавания речи
ASR_URL=http://127.0.0.1:8081/transcribe
# Все голосовые после ASR отправляются в OpenAI-compatible API.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4-mini
# TRANSCRIBE_MODEL=gpt-transcribe
# TRANSCRIBE_PROMPT=Русский личный дневник. Точно записывай числа и время цифрами.
# Ollama остаётся фолбэком, если LLM_API_KEY не задан.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Пользователи живут в базе и добавляются через /invite. Эта переменная нужна
# только для переноса старой конфигурации: при первом запуске пользователи
# импортируются в базу (пароль — хэшем), после этого её можно удалить.
# Формат: telegram_id:имя:профиль:логин_дашборда:пароль; профили pasha, sveta, basic.
# PASHA_TZ / SVETA_TZ задают пояс при импорте профилей pasha и sveta.
# TRACKER_USERS=949465743:Паша:pasha:owner:change-me
# Лёгкий read-only дашборд. Слушать только localhost, HTTPS — на reverse proxy.
# DASHBOARD_ADDR=127.0.0.1:8080
# Публичный адрес — бот присылает его новым участникам вместе с паролем.
# DASHBOARD_URL=https://dash.example.com
# Логин и пароль владельца, если TRACKER_USERS не задан и база пустая.
# DASHBOARD_USER=tracker
# DASHBOARD_PASSWORD=change-me

# Ежедневная SQLite-копия локально и в Telegram главного OWNER_ID.
# BACKUP_DIR=/opt/tracker/data/backups
# DAILY_BACKUP=04:00

# Пороги для флагов недельного разбора (значения по умолчанию)
# MAX_WAKE_SPREAD_H=1.5
# MIN_SAVINGS_RATE=0.55

# Расписание напоминаний
# Время — в часовом поясе каждого пользователя.
# DAILY_REMINDER=22:00
# WEEKLY_REPORT=12:40
# WEEKLY_REPORT_DAYS=7
# 5-го — зарплата, 20-го — аванс.
# INCOME_REMINDER=10:00
# Финансовый итог прошлого месяца и AI-анализ приходят 1-го числа.
# MONTHLY_FINANCE=10:15
